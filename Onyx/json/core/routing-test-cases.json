{
  "version": "1.0",
  "cases": [
    {
      "prompt": "Create a book cover for my novel",
      "expect": [
        "books-publishing",
        "art-design",
        "layout",
        "branding"
      ]
    },
    {
      "prompt": "Build a tabletop RPG with classes, rules, sheets, maps and combat",
      "expect": [
        "ttrpg",
        "game-design",
        "worldbuilding",
        "vtt-maps",
        "balancing"
      ]
    },
    {
      "prompt": "Make a private social network for friends",
