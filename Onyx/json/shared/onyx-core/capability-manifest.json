{
  "schema": "onyx.unified-capability-manifest.v1",
  "version": "1.2.0",
  "surfaces": {
    "onyx-core": [
      "regular-chat",
      "work",
      "writing",
      "coding",
      "ideas",
      "research",
      "files",
      "projects"
    ]
  },
  "sharedRuntime": "Onyx/script/js/onyx/onyx-core/index.js",
  "backend": {
    "authority": "existing OurSpace Apps Script deployment",
    "modified": false,
    "credentialsInFrontend": false,
    "actions": [
      "onyx.health",
      "onyx.chat",
      "onyx.chat.history",
      "onyx.ai.capabilities",
      "onyx.ai.web.search",
      "onyx.ai.url.fetch",
      "onyx.ai.file.parse",
      "onyx.ai.file.upload",
      "onyx.ai.file.archive",
      "onyx.ai.image.generate"
    ]
  },
  "providers": {
    "ourspace-ai-brain": {
      "default": true,
      "continuity": "profile-scoped",
      "privateContext": "backend-only",
      "completionProofRequired": true,
      "matchingProfileProofRequired": true,
      "personalityFilterProofRequired": true
    },
    "ollama": {
      "default": false,
      "mode": "explicit opt-in",
      "network": "loopback-only unless explicitly allowed",
      "privateBackendContextShared": false,
      "completionProofRequired": true
    }
  },
  "agent": {
    "pattern": "bounded plan-execute-verify",
    "maximumSteps": 6,
    "repeatedStepGuard": true,
    "writesRequireExplicitUserIntent": true
  },
  "scope": "Onyx is brain-only; UI, games, widgets, and sprite assets are stored elsewhere."
}
