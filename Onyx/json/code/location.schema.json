{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universal.local/schemas/location.schema.json",
  "title": "universal.location.v8",
  "type": "object",
  "required": [
    "locationId",
    "name",
    "category",
    "accessibility"
  ],
  "properties": {
    "locationId": {
      "type": "string"
    },
    "settlementId": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "services": {
      "type": "array"
    },
    "workers": {
      "type": "array"
    },
    "residents": {
      "type": "array"
    },
    "accessibility": {
      "type": "object",
      "required": [
        "stepFree"
      ]
    },
    "worldContext": {
      "type": "object"
    }
  },
  "additionalProperties": true
}