{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "universal.project-directory.v2",
  "title": "Universal Project Directory",
  "type": "object",
  "required": [
    "schema",
    "projects"
  ],
  "properties": {
    "schema": {
      "const": "universal.project-directory.v2"
    },
    "version": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "stack": {
          "type": "string"
        },
        "tags": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "paths": {
          "type": "string"
        },
        "dependencies": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "fileIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "id",
        "name",
        "path",
        "size",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      }
    }
  }
}