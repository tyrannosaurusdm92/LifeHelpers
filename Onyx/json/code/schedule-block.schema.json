{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universal.local/schemas/schedule-block.schema.json",
  "title": "universal.schedule-block.v8",
  "type": "object",
  "required": [
    "scheduleBlockId",
    "startMinute",
    "endMinute",
    "semanticReactionId"
  ],
  "properties": {
    "scheduleBlockId": {
      "type": "string"
    },
    "weekday": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 6
    },
    "startMinute": {
      "type": "number",
      "minimum": 0,
      "maximum": 1439
    },
    "endMinute": {
      "type": "number",
      "minimum": 1,
      "maximum": 1440
    },
    "locationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "semanticReactionId": {
      "type": "string"
    },
    "homeworldActivityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "visualOverridePath": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}