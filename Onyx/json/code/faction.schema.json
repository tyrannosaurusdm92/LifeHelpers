{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lifesimulation://schemas/faction.schema.json",
  "title": "LifeSimulation Faction",
  "type": "object",
  "required": [
    "factionId",
    "name",
    "public",
    "private",
    "goals",
    "methods",
    "relationships",
    "provenance"
  ],
  "properties": {
    "factionId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "public": {
      "type": "object"
    },
    "private": {
      "type": "object"
    },
    "goals": {
      "type": "array"
    },
    "methods": {
      "type": "array"
    },
    "resources": {
      "type": "array"
    },
    "leaderNpcIds": {
      "type": "array"
    },
    "memberNpcIds": {
      "type": "array"
    },
    "territory": {
      "type": "array"
    },
    "relationships": {
      "type": "array"
    },
    "exceptions": {
      "type": "array"
    },
    "visibility": {
      "enum": [
        "public",
        "private",
        "secret",
        "protected"
      ]
    },
    "protected": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}