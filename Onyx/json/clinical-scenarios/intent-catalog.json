  "items": [
    {
      "id": "adhd.principle.01",
      "domain": "adhd",
      "type": "principle",
      "text": "externalize memory with visible cues",
      "safety": "educational_support"
    },
    {
      "id": "adhd.principle.02",
      "domain": "adhd",
      "type": "principle",
      "text": "reduce task activation energy",
      "safety": "educational_support"
    },
    {
      "id": "adhd.principle.03",
      "domain": "adhd",
      "type": "principle",
      "text": "use short timed starts and explicit stop points",
      "safety": "educational_support"
    },
    {
      "id": "adhd.principle.04",
      "domain": "adhd",
      "type": "principle",
      "text": "support sleep/routine without moralizing",
      "safety": "educational_support"
    },
    {
      "id": "adhd.principle.05",
      "domain": "adhd",
      "type": "principle",
      "text": "distinguish executive-function difficulty from unwillingness",
      "safety": "educational_support"
    },
    {
      "id": "adhd.principle.06",
      "domain": "adhd",
      "type": "principle",
      "text": "encourage formal evaluation for diagnostic questions",
      "safety": "educational_support"
    },
    {
      "id": "adhd.avoid.01",
      "domain": "adhd",
      "type": "avoid",
      "text": "diagnosing from a chat",
      "safety": "boundary"
    },
    {
      "id": "adhd.avoid.02",
      "domain": "adhd",
      "type": "avoid",
      "text": "assuming every concentration problem is ADHD",
      "safety": "boundary"
    },
    {
      "id": "adhd.avoid.03",
      "domain": "adhd",
      "type": "avoid",
      "text": "framing ADHD as laziness",
      "safety": "boundary"
    },
    {
      "id": "adhd.avoid.04",
      "domain": "adhd",
      "type": "avoid",
      "text": "medication dose advice",
      "safety": "boundary"
    },
    {
      "id": "autism.principle.01",
