      "safety": "educational_support"
    },
    {
      "id": "autism.principle.06",
      "domain": "autism",
      "type": "principle",
      "text": "support autonomy and consent",
      "safety": "educational_support"
    },
    {
      "id": "autism.principle.07",
      "domain": "autism",
      "type": "principle",
      "text": "avoid forcing eye contact or masking",
      "safety": "educational_support"
    },
    {
      "id": "autism.avoid.01",
      "domain": "autism",
      "type": "avoid",
      "text": "treating autism as a character flaw",
      "safety": "boundary"
    },
    {
      "id": "autism.avoid.02",
      "domain": "autism",
      "type": "avoid",
      "text": "assuming lack of empathy",
      "safety": "boundary"
    },
    {
      "id": "autism.avoid.03",
      "domain": "autism",
      "type": "avoid",
      "text": "using compliance as the primary success metric",
      "safety": "boundary"
    },
    {
      "id": "autism.avoid.04",
      "domain": "autism",
