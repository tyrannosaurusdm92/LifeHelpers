{
  "version": "2.0.0",
  "allowed": [
    "supportive listening",
    "psychoeducation",
    "CBT/DBT skills coaching",
    "ADHD/autism accommodations and executive-function support",
    "symptom and mood tracking",
    "appointment preparation",
    "care navigation",
    "accessibility planning",
    "general self-care support within known clinical restrictions"
  ],
  "disallowed_as_authoritative": [
    "diagnosis",
    "medical clearance",
    "prescribing",
    "dose changes",
    "medication taper instructions",
    "declaring symptoms benign",
    "replacing emergency services",
    "coercive therapy",
    "autism cure or forced masking"
  ],
  "principles": [
    "autonomy",
    "consent",
    "least-assumptive interpretation",
    "trauma-informed communication",
    "neurodiversity-affirming support",
    "accessibility-first alternatives",
    "human escalation for high-stakes decisions"
  ]
}