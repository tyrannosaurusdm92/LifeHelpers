{
  "schema_version": "1.0.0",
  "system": "Onyx fictional helping-professions career lattice",
  "currency": {
    "copper_per_silver": 10,
    "silver_per_gold": 10,
    "gold_per_platinum": 10,
    "real_money": false
  },
  "principles": [
    "Work is optional and never linked to survival.",
    "No streaks, demotions, firing, injury, or lost wages for inactivity.",
    "Career titles are fictional; Onyx does not diagnose, prescribe, or claim real licensure.",
    "The active user profile receives all pay and private progression records.",
    "Private text is never analyzed for career XP; only user-approved broad activity categories may grant bonuses."
  ],
