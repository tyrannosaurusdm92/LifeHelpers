{
  "schema": "ourspace.self-care.shared.v1",
  "version": "2.0.0-canonical-2026-11-06",
  "description": "Optional accessible patterns available to either person; personal medical context stays out of shared.",
  "supportCategories": [
    "physical",
    "mental",
    "emotional",
    "environment",
    "connection",
    "rest",
    "comfort",
    "executive function",
    "DBT"
  ],
  "promptTemplates": [
    {
      "id": "body",
      "label": "What does my body need?",
      "responseType": "optional journal"
    },
    {
      "id": "feelings",
      "label": "How am I feeling?",
      "responseType": "optional mood"
    },
    {
      "id": "tiny-step",
      "label": "What is one tiny safe step?",
      "responseType": "optional action"
    },
    {
      "id": "comfort",
      "label": "Would a comfort break help?",
      "responseType": "optional action"
    },
    {
      "id": "support",
      "label": "Do I want to ask someone for support?",
      "responseType": "optional action"
    }
  ],
  "carePractices": {
    "partialCounts": true,
    "lowEnergyModes": true,
    "snoozeAllowed": true,
    "restEarnsAcknowledgement": true,
    "noShame": true,
    "noClinicianPretence": true
  },
  "DBT": {
    "examples": [
      "STOP",
      "Check the Facts",
      "grounding",
      "pros and cons"
    ],
    "OnyxCoachOnly": true,
    "requiresPersonalOptIn": true
  },
  "noSharedMedicalRecords": true,
