{
  "schema": "ourspace.canonical.frontend-contract.v2",
  "version": "2.0.0-canonical-2026-11-06",
  "source": "static-local-json-only",
  "sourcePath": "json/{william|jasper|shared}/{kind}.json",
  "backendModifications": false,
  "canonicalDocumentsUnmodified": true,
  "ownerDocumentKinds": [
    "tasks",
    "shop",
    "cats",
    "self_care",
    "life_events"
  ],
  "sharedDocumentKinds": [
    "tasks",
    "shop",
    "cats",
    "self_care",
    "life_events",
    "currency",
    "game_rules",
    "manifest"
  ],
  "defaultModules": {
    "household": "tasks",
    "store": "shop"
  },
  "sessionAndPetState": {
    "storage": "localStorage per profile and slot",
    "mayBeReplacedByFutureOnyxWidget": true,
    "notWrittenBackToPackagedJson": true
  },
  "futureOnyxHooks": {
    "api": "window.OurSpaceCanonical",
    "methods": [
      "read",
      "catalog",
      "getVirtualPets",
      "onyxContext",
      "getSession",
      "saveSession",
      "getPetState",
      "savePetState"
    ],
    "events": [
      "ourspace:canonical:ready",
      "ourspace:canonical:tasks-updated",
      "ourspace:canonical:task-completed",
      "ourspace:canonical:session-saved",
      "ourspace:canonical:pet-state-saved"
    ]
  },
  "securityWarning": "Public GitHub Pages JSON is accessible without logging in. Anyone who knows the URL can read all personal and health-related files. Website login does NOT restrict static JSON URL access.",
  "userInstruction": "JSON files placed in frontend as-is. Backend file and deployed Apps Script are unchanged."
}
