{
  "name": "OurSpace",
  "short_name": "OurSpace",
  "description": "OurSpace \u2014 profile-synced installable web app.",
  "id": "./",
  "start_url": "./ourspace.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#242424",
  "theme_color": "#242424",
  "icons": [
    {
      "src": "assets/images/ourspace-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/ourspace-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/ourspace-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
